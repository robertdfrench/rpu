# This program builds one row of a multiplication table in
# memory. It computes 3*1, 3*2, 3*3, 3*4, and 3*5, storing each
# result at consecutive memory addresses starting at 200.
#
# Then it reads back the 4th entry (3*4 = 12) and displays it
# on LCD0 to verify.

; address = 200 (where we start storing results)
put 200 gp0

; address_step = 2 (each u16 takes 2 bytes)
put 2 gp1

; multiplier = 3
put 3 gp2

; counter = 5 (five entries to compute)
put 5 gp3

; decrement = 1
put 1 gp4

; multiplicand = 0 (will be incremented to 1, 2, 3, 4, 5)
put 0 gp7

put .LOOP gp5
put .DONE gp6

noop .LOOP
; Increment multiplicand (1, 2, 3, 4, 5)
add gp7 gp4
copy ans gp7

; Compute multiplier * multiplicand
mul gp2 gp7

; Store result at current address
write ans gp0

; Advance address by 2
add gp0 gp1
copy ans gp0

; Decrement counter
sub gp3 gp4
copy ans gp3

; If counter == 0, done
jump gp6 gp3

; Otherwise, loop
jump gp5 zero

; --- Verify: read the 4th entry (3 * 4 = 12) ---
; The 4th entry is at address 200 + 3*2 = 206
put 206 gp0       .DONE
read gp0 gp7

put 0 dvc
copy gp7 out

halt

; Study questions:
; - Watch the memory pane as the program runs. Can you see the
;   values 3, 6, 9, 12, 15 appearing at addresses 200-208?
; - How would you build a full 5x5 table? You would need two
;   loops: an outer loop for each row and an inner loop for
;   each column. Try it -- but be warned, it uses a lot of
;   registers!
; - What address would hold the value for row 4, column 5?
